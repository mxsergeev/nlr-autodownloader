NODE_ENV=production
# Host port. Compose maps this to the server's internal port 3333.
SERVER_PORT=3333
# Listen host for standalone server runs. Compose overrides this to the
# container interface while binding the published host port to localhost.
SERVER_HOST=127.0.0.1
# Host directory used by Compose for the internal /data/downloads path.
DOWNLOADS_HOST_DIR=./data/downloads
# Container path used by the Node process. Keep this at /data/downloads in Compose.
DOWNLOADS_DIR=/data/downloads
CONCURRENT_DOWNLOADS=2
MAX_BROWSER_CONTEXTS=3
# Maximum time Vivaldi may take to prepare a document part for download.
DOWNLOAD_PREPARATION_TIMEOUT_MS=120000
# Maximum time to wait for the browser download event.
DOWNLOAD_EVENT_TIMEOUT_MS=30000

REDIS_PASSWORD=1234
# Internal Redis service port. Redis is not published to the host by default.
REDIS_PORT=6379
# The Compose server override sets these internal service values explicitly.
REDIS_HOST=redis
REDIS_DB=0

# Maximum number of query objects accepted in one POST /api/queue request.
MAX_QUEUE_BATCH_SIZE=100
# Dependency timeout used by GET /health/ready, in milliseconds.
READINESS_TIMEOUT_MS=1000

DATABASE_URL=file:/data/queries/nlr.db
